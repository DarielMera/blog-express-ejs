      <!-- ==========  TEXT-AREA ========== -->

      <div class="container-fluid my-5 py-5">
        <h2 class="text-white bg-secondary p-2  bg-opacity-50">Your story begins now. Start writing...</h2>
        <form action="/submit" method="POST">
          <div class="mb-3 mt-3">
            <label for="comment" class="text-secondary">What's in your mind:</label>
            <div class="input-group input-group-sm mb-3">
              <span class="input-group-text" id="inputGroup-sizing-sm">Title</span>
              <input type="text" class="form-control" name="title" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm">
            </div>
            <textarea class="form-control" rows="5" id="comment" name="story"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Post</button>
        </form>
      </div>
    




  