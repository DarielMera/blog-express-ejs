<!-- ==========  ACCORDION ========== -->
<div class="container-fluid accordion accordion-flush" id="accordionFlushExample">
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
        data-bs-target="#flush-collapseOne" aria-expanded="false" aria-controls="flush-collapseOne">
        <% if (entries && entries.length > 0) { %>
          <span class="fs-5 mx-5 text-muted"><%= entries[0].timestamp %></span>
          <span class="fs-3 mx-5 text-warning"><%= entries[0].title%></span>
        <% } else { %>
          <span class="fs-6 text-muted">Title!</span>
        <% } %>
      </button>
    </h2>
    <div id="flush-collapseOne" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
      <div class="accordion-body">
        <% if (entries[0].story) { %>
          <span class="fs-6"><%= entries[0].story %></span>
        <% } else { %>
          <span class="fs-6 text-muted">your story!</span>
        <% } %>
      </div>
    </div>
  </div>
</div>
